{
  "name": "@clawdbot/memory-pgvector",
  "version": "0.4.0",
  "description": "PostgreSQL + pgvector memory backend",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test": "vitest run db.test.ts",
    "test:db:up": "docker-compose -f docker-compose.test.yml up -d && sleep 2",
    "test:db:down": "docker-compose -f docker-compose.test.yml down -v",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.32.0",
    "pg": "^8.13.0",
    "pg-format": "^1.0.4"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@types/pg-format": "^1.0.5",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
