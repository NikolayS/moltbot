{
  "name": "@clawdbot/memory-pgvector",
  "version": "0.3.0",
  "description": "PostgreSQL + pgvector memory backend for Clawdbot with multi-agent isolation",
  "type": "module",
  "main": "index.ts",
  "clawdbot": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run --exclude '**/integration.test.ts'",
    "test:watch": "vitest --exclude '**/integration.test.ts'",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:all": "vitest run",
    "test:db:up": "docker-compose -f docker-compose.test.yml up -d && sleep 3",
    "test:db:down": "docker-compose -f docker-compose.test.yml down -v",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "clawdbot",
    "memory",
    "pgvector",
    "postgresql",
    "embeddings",
    "vector-search"
  ],
  "author": "PostgresAI",
  "license": "MIT",
  "dependencies": {
    "@sinclair/typebox": "^0.32.0",
    "openai": "^4.0.0",
    "pg": "^8.13.0",
    "pg-format": "^1.0.4"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@types/pg-format": "^1.0.5",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "clawdbot": ">=2025.1.0"
  }
}
